# Relativo à pasta backend; o diretório é criado automaticamente.
DATABASE_PATH=data/chat.sqlite3
TOKEN_TTL_SECONDS=28800
# simulated (respostas por regras), echo (eco) ou unavailable (teste de 503).
LLM_PROVIDER=simulated
# Opcional: diretório absoluto dos dados das sprints. Padrão: data/ na raiz do repositório.
